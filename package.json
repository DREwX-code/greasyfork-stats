{
  "name": "greasyfork-stats",
  "version": "0.1.0",
  "private": true,
  "description": "Dynamic GreasyFork statistics cards for GitHub READMEs and online profiles.",
  "type": "module",
  "engines": {
    "node": "^24.8.0"
  },
  "scripts": {
    "dev": "vercel dev",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint index.html --max-warnings 0",
    "lint:html": "html-validate index.html --max-warnings 0",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "keywords": [
    "greasyfork",
    "stats",
    "svg",
    "readme-card",
    "github-readme",
    "userscripts",
    "vercel",
    "serverless"
  ],
  "author": "Andrew (Dℝ∃wX)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-plugin-html": "8.2.0",
    "globals": "17.12.0",
    "html-validate": "11.12.0",
    "postcss": "8.5.26",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "vercel": "59.11.2"
  }
}
